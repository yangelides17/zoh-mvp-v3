{
  "name": "zoh-mvp-v3",
  "version": "0.3.0",
  "private": true,
  "description": "ZOH MVP v3: text-based coach over iMessage (Sendblue + Claude)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate-cli.js",
    "eval": "tsx eval/run.ts",
    "grader-check": "tsx eval/grader-check.ts",
    "sim-check": "tsx eval/sim-check.ts",
    "real": "tsx eval/real.ts",
    "memory": "tsx src/memory/show-cli.ts",
    "load-scenario": "tsx src/synthetic/load-cli.ts",
    "lab:replay": "tsx eval/memory-lab/replay-cli.ts",
    "lab:grade": "tsx eval/memory-lab/grade-cli.ts",
    "inventory": "tsx scripts/prompt-inventory.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@fastify/multipart": "^9.4.0",
    "@google/genai": "^3.3.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "heic-convert": "^2.1.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "unpdf": "^2.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "rolldown": "^1.2.15",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
