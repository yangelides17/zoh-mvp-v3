# Copy to .env for local development. Never commit real values.
# On Railway these are service variables (see README → "Railway variables").

PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zoh

# Sendblue (AI Agent line)
SENDBLUE_API_KEY_ID=
SENDBLUE_API_KEY_SECRET=
SENDBLUE_NUMBER=+19177412162
SENDBLUE_WEBHOOK_SECRET=
TYPING_INDICATOR=true

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=400

# Only these numbers get replies while we build (comma-separated E.164)
ALLOWED_NUMBERS=+19085550100
# Dev accounts: marked as test users and can text "reset" (comma-separated E.164)
DEV_NUMBERS=+19085550100

# Railway Storage Bucket (S3-compatible)
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_REGION=auto
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_FORCE_PATH_STYLE=false

# Speaches (Whisper transcription)
SPEACHES_URL=
SPEACHES_API_KEY=
SPEACHES_MODEL=Systran/faster-distil-whisper-small.en
